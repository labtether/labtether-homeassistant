{
  "name": "LabTether",
  "slug": "labtether",
  "description": "Runs the LabTether hub in Home Assistant.",
  "version": "2.0.1",
  "stage": "experimental",
  "arch": ["aarch64", "amd64"],
  "startup": "services",
  "boot": "auto",
  "backup": "cold",
  "init": false,
  "host_network": false,
  "ingress": false,
  "ingress_port": 8443,
  "webui": "https://[HOST]:[PORT:3000]/",
  "ports_description": {
    "3000/tcp": "LabTether web console (HTTPS; plain HTTP when tls_mode is disabled)",
    "8080/tcp": "LabTether HTTP redirect and health check (not published by default)",
    "8443/tcp": "LabTether Hub API and agent connections (HTTPS unless tls_mode is disabled)"
  },
  "ports": {
    "3000/tcp": 3000,
    "8080/tcp": null,
    "8443/tcp": 8443
  },
  "map": ["ssl:ro"],
  "options": {
    "labtether_owner_token": "",
    "labtether_admin_password": "",
    "labtether_setup_token": "",
    "encryption_key": "",
    "database_url": "",
    "tls_mode": "auto",
    "external_url": "",
    "auto_generate_credentials": true
  },
  "schema": {
    "labtether_owner_token": "str?",
    "labtether_admin_password": "str?",
    "labtether_setup_token": "str?",
    "encryption_key": "str?",
    "database_url": "str?",
    "tls_mode": "list(auto|disabled)",
    "external_url": "str?",
    "auto_generate_credentials": "bool"
  }
}
